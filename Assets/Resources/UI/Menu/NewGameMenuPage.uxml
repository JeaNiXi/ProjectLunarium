<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="leftVE" style="flex-basis: 10%;"/>
        <ui:VisualElement name="centerVE" style="flex-basis: 80%; background-color: rgb(255, 255, 255);">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:VisualElement name="header" style="flex-basis: 10%;">
                    <ui:Label text="Создание Новой Игры:"/>
                </ui:VisualElement>
                <ui:VisualElement name="body" style="flex-basis: 80%;">
                    <ui:VisualElement name="page1VE" style="flex-grow: 1; display: none;">
                        <ui:VisualElement style="flex-basis: 30%;">
                            <ui:Label text="Добро пожаловать в меню создания новой игры. Пожалуйста выберите сценарий:" style="font-size: 26px; white-space: pre-wrap;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-basis: 70%;">
                            <ui:VisualElement name="" style="flex-grow: 1;">
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Button text="Стандартная игра:" name="selectStandardNewGameButton"/>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Будет Создана Стандартная Игра"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Button text="Кастомизация" enabled="false"/>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Пока не доступно."/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="page2VE" style="flex-grow: 1; display: none;">
                        <ui:VisualElement style="flex-basis: 10%;">
                            <ui:Label text="Выберите Вашу Стартовую Расу:" style="display: none;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-basis: 80%;">
                            <ui:VisualElement style="flex-basis: 100%; flex-direction: row;">
                                <ui:VisualElement style="flex-basis: 20%;">
                                    <ui:VisualElement>
                                        <ui:Button text="Люди" name="StartRaceSelectHumansButton"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement>
                                        <ui:Button text="Эльфы" name="StartRaceSelectElfButton"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-basis: 80%;">
                                    <ui:Label name="raceDescriptionLabel" text="" style="-unity-text-align: upper-left;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="" style="flex-basis: 10%;">
                            <ui:Toggle label="Галочка просто так:" name="AcceptToggle"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="lower" style="flex-basis: 10%;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:VisualElement style="flex-basis: 20%;">
                            <ui:Button text="Назад" name="newGameBackButtonPage"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-basis: 60%;">
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:VisualElement style="flex-grow: 1;"/>
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Button text="Start" name="newGameStartButtonPage" enabled="false"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-basis: 20%;">
                            <ui:Button text="Далее" name="newGameNextButtonPage"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rightVE" style="flex-basis: 10%;"/>
    </ui:VisualElement>
</ui:UXML>
