<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pages/ResourcePanel.uss?fileID=7433441132597879392&amp;guid=c520f4cb79430a94ab9cef7f03298fdf&amp;type=3#ResourcePanel"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement name="defaultResource" style="background-color: rgba(25, 25, 51, 0.6); flex-basis: auto; flex-direction: row; margin-bottom: 5px; margin-top: 5px; height: 104px; flex-grow: 1;">
            <ui:VisualElement name="leftElement" style="flex-direction: row; flex-basis: 30%;">
                <ui:VisualElement name="leftLVE" style="flex-basis: 30%;">
                    <ui:Button text="Иконка" name="buttonIcon" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement name="rightLVE" style="flex-basis: 70%;">
                    <ui:VisualElement name="nameVE" style="flex-basis: 40%; flex-direction: row;">
                        <ui:Button text="Pin" name="pinButton"/>
                        <ui:Label text="Название" name="nameLabel" class="display-main-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="animationVE" style="flex-basis: 60%;">
                        <ui:Image source="project://database/Assets/Data/Test/elf_walk.gif?fileID=145885272568563908&amp;guid=e470b151ddeef604ca261877c959f2a1&amp;type=3#elf_walk_0" name="resourceImage"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="rightElement" style="flex-basis: 70%;">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement style="flex-basis: 20%; justify-content: space-around;">
                        <ui:Label text="Количество рабочих:"/>
                        <ui:Label text="Label" name="currentWorkers"/>
                        <ui:Label text="Мест доступно:"/>
                        <ui:Label text="Label" name="maxWorkerPlaces"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-basis: 20%; -unity-text-auto-size: none; flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement style="flex-grow: 1; flex-basis: 10%; justify-content: space-around;">
                            <ui:Label text="Рабочие:" style="-unity-text-align: middle-center;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                            <ui:VisualElement style="align-items: center; align-self: center; flex-grow: 1;">
                                <ui:Button text="+1" name="addWorkerButton" style="align-self: center;"/>
                                <ui:Button text="-1" name="removeWorkerButton"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1; align-items: center; align-self: center;">
                                <ui:Button text="+10"/>
                                <ui:Button text="-10"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1; align-items: center; align-self: center;">
                                <ui:Button text="+100"/>
                                <ui:Button text="-100"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1; align-items: center; align-self: center;">
                                <ui:Button text="+1000"/>
                                <ui:Button text="-1000"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-basis: 60%; flex-direction: row;">
                        <ui:VisualElement style="flex-basis: 25%;">
                            <ui:VisualElement style="flex-grow: 1; justify-content: space-around;">
                                <ui:Label text="Расход в день:"/>
                                <ui:Label text="Прибыль в день:" name=""/>
                                <ui:Label text="Label"/>
                                <ui:Label text="Label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-basis: 75%; flex-direction: row;">
                            <ui:VisualElement style="flex-basis: 35%; justify-content: space-around;">
                                <ui:Label text="Остаток на складе:"/>
                                <ui:Label text="Label" name="currentAmount" binding-path="Amount" class="display-main-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                <ui:VisualElement style="flex-basis: 60%;">
                                    <ui:VisualElement style="flex-basis: 30%;">
                                        <ui:Label text="Место производства:"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-basis: 70%;">
                                        <ui:Button text="Button" style="flex-grow: 1;"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-basis: 40%;">
                                    <ui:VisualElement name="" style="flex-basis: 40%;">
                                        <ui:Label text="Остановить Добычку:" style="white-space: pre-wrap; -unity-text-align: middle-center;"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-basis: 60%;">
                                        <ui:Button text="Button" style="flex-grow: 1;"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
