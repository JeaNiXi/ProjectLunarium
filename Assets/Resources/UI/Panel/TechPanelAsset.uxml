<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="mainColorElement" style="flex-grow: 1; flex-basis: 100%; flex-direction: row; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
        <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row; background-color: rgba(0, 0, 0, 0.8);">
            <ui:VisualElement style="flex-basis: 30%; justify-content: space-around;">
                <ui:Button text="Технология" name="mainTechInfoButton" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-basis: 70%;">
                <ui:VisualElement style="flex-basis: 30%;">
                    <ui:Label text="Название Технологии" name="techNameLabel" style="font-size: 24px; flex-grow: 1; flex-direction: row; align-self: center; -unity-text-align: upper-center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="vePlaceholderForUnlocksIcons" style="flex-basis: 70%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
