                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-direction: row; flex-basis: 80%;">
            <ui:VisualElement style="flex-basis: 14%;"/>
            <ui:VisualElement style="flex-basis: 86%;">
                <ui:VisualElement style="flex-basis: 90%; flex-direction: row;">
                    <ui:VisualElement name="techPageMainView" style="flex-basis: 55%;">
                        <ui:ScrollView name="mainScrollView" style="flex-basis: 100%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-basis: 45%;">
                        <ui:VisualElement name="mainInfoPanelVisualElement" style="flex-grow: 1;">
