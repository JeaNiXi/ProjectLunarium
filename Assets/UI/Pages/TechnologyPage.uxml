<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pages/TechnologyPage.uss?fileID=7433441132597879392&amp;guid=cd04ec729039d77408af649abac2828a&amp;type=3#TechnologyPage"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement name="upPanelCurrentResearch" style="flex-basis: 20%; flex-direction: row;">
            <ui:VisualElement style="flex-basis: 14%;">
                <ui:VisualElement style="flex-basis: 100%;">
                    <ui:Button text="Button" name="currentResearchInfoButton" style="flex-grow: 1;"/>
